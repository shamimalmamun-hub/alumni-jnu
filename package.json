{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=server.cjs",
    "start": "node server.cjs",
    "deploy": "npm run build && wrangler deploy",
    "preview": "vite preview",
    "clean": "rm -rf dist server.cjs server.cjs.map",
    "lint": "tsc --noEmit",
    "dev:worker": "wrangler dev --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply alumni-jnu --local",
    "db:migrate:remote": "wrangler d1 migrations apply alumni-jnu --remote",
    "db:seed:local": "wrangler d1 execute alumni-jnu --local --file=scripts/seed-registration.sql",
    "db:seed:remote": "wrangler d1 execute alumni-jnu --remote --file=scripts/seed-registration.sql"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.17.1",
    "html2canvas": "^1.4.1",
    "html2canvas-pro": "^2.4.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "resend": "^6.28.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "@types/express": "^4.17.21"
  }
}
